return {
  summary = "Emerald Safari overhaul: every wild and fated encounter runs the native Safari scene; four XP-driven skills (catch rate, likeability, ball regen, ball cap) level from safari activity, reported in the Start menu SAFARI row.",
  author = "tectorifter",
  tags = { "gen3", "emerald", "safari", "catch", "skills" },
  differences = {
    added = {
      "Wild encounters and fated (scripted/static) encounters open the native Emerald Safari scene instead of the normal combat scene. Trainer battles are untouched.",
      "Deep Safari Ball stock (10 base cap, +2 per BALL CAP level to 70) with wall-clock regen: one ball per interval, starting at 12 real seconds down to 5 seconds at max level. Wall-clock time is immune to game speed. SAFARI BALL is always listed in the bag with the live count, even at 0.",
      "Four skills level from XP, never from a shop: SAFARI UPG (+0.35 catch rate per level, 60 levels) from catches; LIKEABLE (flee divisor 1 + 0.1 per level, cap 4, 30 levels) from flee-fails, POKéBLOCKs and failed overworld throws; BALL RECOVERY (regen interval per level, 70 levels) from steps, overworld throws/catches and ended encounters; BALL CAP (+2 cap per level, 30 levels) from throwing efficiency and new species (overworld catches pay a flat +4). The Start menu SAFARI row reports each skill's level, progress and current effect.",
      "Safari catches pay scaled EXP (EXP YIELD setting, default 50% of what the species would yield if defeated) to every alive sub-100 non-egg party mon through the normal in-battle presentation.",
      "The Hoenn Safari Zone entrance desk is disabled while the mod is on (everywhere is already safari): you walk past with no fee and no timed game.",
      "Partner moves: the Torchic, Treecko, and Mudkip lines each own four exclusive moves (home ids 355-366, moved clear of dex-mod moves when that mod is present: a friendship-powered never-miss strike, a dual-stat dropping Dark hit, a Reflect-setting Rock hit, a Speed-raising Fire hit, a first-turn flinching sprint, a draining Dragon hit, a seeding Ground hit, a Speed-dropping Flying hit, a status-curing priority Protect, a never-miss all-battler quake, a counter-style Water trap, a Defense-dropping Ice hit), taught to your partner by talking to Mom in Littleroot (TUTOR) for any species candy (5/10/15/25) as you earn badges (1/3/5/6); line abilities become Intimidate / Lightning Rod / Mud Force (+30% Attack in rain), the rival's line mons carry their badge-allowed moves, and Wally fields the third line.",
    },
    known = {
      "an unofficial fan mod: Pokemon and all related names and assets are (c) Nintendo / Creatures Inc. / GAME FREAK inc. / The Pokemon Company and this project is not affiliated with or endorsed by them",
    },
  },
  compat = { engine = ">=0.0.0-0 <2.0.0", modApi = 2 },
}
